{
  "name": "zcode-pet",
  "version": "0.1.0",
  "description": "ZCode 窗口里的像素桌宠:token/费用/余额胶囊 + 养成系统。A pixel desktop pet living inside the ZCode window.",
  "displayName": "桌宠",
  "displayName_i18n": { "zh-CN": "桌宠", "en": "ZCode Pet" },
  "author": { "name": "your-github-name" },
  "license": "MIT",
  "repository": "https://github.com/your-github-name/zcode-pet",
  "keywords": ["zcode", "desktop-pet", "tamagotchi", "token-usage", "pixel-art"],
  "category": "utilities",
  "commands": "commands",
  "mcpServers": {
    "zcode-pet": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/server.js"],
      "env": { "PET_CHIP_DATA": "${ZCODE_PLUGIN_DATA}" }
    }
  }
}
